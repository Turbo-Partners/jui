{% schema %}
{
    "name": "TP - vídeo slides",
    "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Título",
                "default": "Seu Suco Verde nunca foi tão Gostoso e Prático"
            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "Estrela"
            }
        ],
    "max_blocks": 12,
    "blocks": [
        {
            "type": "card",
            "name": "Card",
            "settings": [
                {
                    "type": "url",
                    "id": "url__video",
                    "label": "URL do Vídeo"
                },
              {
                "type": "video",
                "id": "video",
                "label": "Video",

              }
            ]
        }
    ],
    "presets": [
        {"name": "TP - Prático"}
    ]
}
{% endschema %}

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<div class="{{ section.id }}">
  <div class="page-width">
    <div class="{{ section.id }}-title">
      <h1>
        <b>{{ section.settings.title }}</b>
      </h1>
      <!-- <img src="{{ section.settings.image | img_url }}" alt="stars"> -->
    </div>

    <div class="{{ section.id }}-swiper">
      <div class="{{ section.id }}-swiper-wrapper swiper-wrapper">
        {% for block in section.blocks %}
          <div class="{{ section.id }}-swiper-slide swiper-slide">
            {{ block.settings.video | video_tag: controls: true, autoplay: true, loop: true }}
            {% comment %}<video src="{{ block.settings.url__video }}"></video>{% endcomment %}
          </div>
        {% endfor %}
      </div>
      <div class="{{section.id}}__swiper-pagination"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const swiperPratica = new Swiper('.{{ section.id }}-swiper', {
      direction: 'horizontal',
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      pagination: {
        el: ".{{section.id}}__swiper-pagination",
        clickable: true,
      },
      loop: false,
      slidesPerView: 2,
      spaceBetween: 10,
      breakpoints: {
        320: {
          slidesPerView: 2,
          spaceBetween: 10
        },
        728: {
          slidesPerView: 4,
          spaceBetween: 10
        }
      }
    });

    // Add the 'initialized' class once the Swiper is fully initialized
    swiperPratica.on('init', function () {
      document.querySelector('.{{ section.id }}-swiper').classList.add('initialized');
    });

    // Initialize the Swiper to trigger the 'init' event
    swiperPratica.init();
  });
</script>

{% style %}
    @font-face {
    font-family: 'Athletics', sans-serif;
    src: url('{{ 'Athletics-Regular.otf' | asset_url }}') format('otf'),
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Manrope', sans-serif;
    src: url('{{ 'Manrope-Regular.ttf' | asset_url }}') format('ttf'),
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

   h1 {
    font-family: Athletics, sans-serif !important;
  }

  .{{section.id}}__swiper-pagination {
    display: flex;
    justify-content: center;
    margin-top: 16px;
  }

  .{{section.id}}__swiper-pagination .swiper-pagination-bullet {
    background: #B3D825;
  }
  
  .swiper-button-next, swiper-button-prev {
    width: 20px;
    height: 20px;
    background: yellow;
  }

  .{{ section.id }}{
      padding-top: 4rem;
      padding-bottom: 2rem;
      /* background: linear-gradient(0deg, rgba(255,255,255,1) 53%, rgba(255,243,220,1) 53%); */
      background: rgba(255,243,220,1);
      width: 100%;
      overflow: hidden;
  }

  .{{ section.id }}-swiper {
    overflow: hidden;
  }


  .{{ section.id }}-title{
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center;
      justify-content: center;
      margin-bottom: 2rem;
      font-family: 'Assistant';
  }
  .{{ section.id }}-title > h1 {
      text-align: center;
      font-size: 3.2rem;
  }

  .{{ section.id }}-swiper-slide > video{
      width: 100%;
      border-radius: 1rem;
  }


{% endstyle %}
