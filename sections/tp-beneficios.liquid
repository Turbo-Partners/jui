{% style %}
    .{{ section.id }} {
        padding-top: 24px;
        padding-bottom: 48px;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .{{ section.id }} h4 {
        color: #3D4326;
        text-align: center;
        font-family: Manrope;
        font-size: 32px;
        font-style: normal;
        font-weight: 700;
        line-height: 120%; /* 38.4px */
        letter-spacing: 0.6px;
        margin: 0;
    }

    .{{ section.id }} .beneficios-wrapper {
        display: grid;
        grid-template-columns: auto auto;
        grid-template-rows: auto auto;
        row-gap: 24px;
    }

    .{{ section.id }} .beneficios-wrapper .beneficio {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .{{ section.id }} .beneficios-wrapper .beneficio p {
        color: #3D4326;
        text-align: center;
        font-family: Manrope;
        font-size: 14px;
        font-style: normal;
        font-weight: 600;
        line-height: 150%; /* 21px */
        letter-spacing: 0.5px;
        margin: 0;
    }

    @media screen and (min-width: 1024px) {
        .{{ section.id }} .beneficios-wrapper {
            grid-template-columns: auto auto auto auto;
        }

        .{{ section.id }} { 
            gap: 64px;
        }

        .{{ section.id }} h4 {
            color: #3D4326;
            text-align: center;
            font-family: Manrope;
            font-size: 56px;
            font-style: normal;
            font-weight: 700;
            line-height: 120%; /* 67.2px */
            letter-spacing: 0.6px;
        }

        .{{ section.id }} .beneficios-wrapper .beneficio svg {
            width: 143px;
            height: auto;
        }

        .{{ section.id }} .beneficios-wrapper .beneficio p {
            color: #3D4326;
            text-align: center;
            font-family: Manrope;
            font-size: 16px;
            font-style: normal;
            font-weight: 600;
            line-height: 150%; /* 30px */
            letter-spacing: 0.6px;
        }
    }
{% endstyle %}

<section class="{{ section.id }} page-width">
    <h4>{{ section.settings.header }}</h4>
    <div class="beneficios-wrapper">
        {% for beneficio in section.blocks %}
            <div class="beneficio">
                {% if beneficio.settings.image %}
                    <img src="{{ beneficio.settings.image | img_url: 'master' }}">
                {% elsif beneficio.settings.svg %}
                    {{ beneficio.settings.svg }}
                {% endif %}
                <p>{{ beneficio.settings.text }}</p>
            </div>
        {% endfor %}
    </div>
</section>

{% schema %}
{
    "name": "TP beneficios",
    "settings": [
        {
            "type": "text",
            "id": "header",
            "label": "Header"
        }
    ],
    "blocks": [
        {
            "name": "Beneficio",
            "type": "beneficio",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image",
                    "info": "Se tiver imagem, tira svg"
                },
                {
                    "type": "html",
                    "id": "svg",
                    "label": "SVG",
                    "info": "aparece se nao tiver imagem"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "Text"
                }
            ],
            "limit": 4
        }
    ],
    "presets": [
        {
            "name": "TP Beneficios"
        }
    ]
}
{% endschema %}