            "label": "Image Desktop"
        },
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Image Mobile"
        }
    ],
    "blocks": [
        {
            "type": "beneficio-column1",
            "name": "Beneficio column 1",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "html",
                    "id": "svg",
                    "label": "SVG"
                },
                {
                    "type": "text",
                    "id": "header",
                    "label": "Header"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "Text"
                }
            ],
            "limit": 2
        },
        {
            "type": "beneficio-column2",
            "name": "Beneficio column 2",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "html",
                    "id": "svg",
                    "label": "SVG"
                },
                {
                    "type": "text",
                    "id": "header",
                    "label": "Header"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "Text"
                }
